# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-local/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (real secrets ignored; the example template is committed)
.env*
!.env.example

# vercel
.vercel

# brand source assets (mockups, font zip, license PDFs) — not needed at build
/_brand

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# local editor/session config
.claude/

# stray local build logs
build-log.txt
*.log

# Build output that got committed once by accident. Never track a build: a future
# NEXT_PUBLIC_* value baked into a client chunk would land in git history for good.
docker/.next/

# Local database dumps — never in git (see docs/BACKUPS.md)
dbbackups/
*.dump

# Private operations, customer audits, and migration artifacts
/.migration/
/.ops-data/
/.codex/
/docs/SYSTEM_*
/docs/SOURCE_*
/docs/VPS-MIGRATION*
/docs/ERP_AMAZON_REVIEW*
/docs/BACKUP_RELIABILITY_20261114.md
/docs/RELEASE-2026-11-14.md
/docs/MCP_PREPARATION_STATUS*
/docs/MCP_SYSTEM_REVIEW*
/docs/AMAZON_CURRENT_PRODUCTS_FIX.md
/docs/SPREADSHEET_PASTE_AR.md
/scripts/check-source-fba*
/scripts/cleanup-source-fba*
/scripts/sync-source-fba*
/scripts/checks/recover-fba-operation-identity*
/scripts/checks/resequence-source-item-codes*
/scripts/checks/audit-live-integrity*
/scripts/checks/audit-system-*
/scripts/checks/chk-core-cycle-audit*
/scripts/checks/chk-live-api-security*
/scripts/checks/chk-item-route-write*
/scripts/checks/chk-stock-number-order*
/scripts/vps/check-rotated-logins*
/scripts/vps/smoke-login*
/scripts/vps/verify-data*
/scripts/vps/verify-storage*
/scripts/vps/rotate-demo-passwords*
/scripts/vps/final-restore*
/scripts/vps/restore-initial*
/scripts/vps/restore-redis*
/scripts/vps/prepare-env*
