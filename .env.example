# ─── Database (Postgres) ───────────────────────────────────────
# Local Docker:
DATABASE_URL=postgres://sellerctrl:sellerctrl@localhost:5432/sellerctrl
#
# RLS cutover (prod): the RUNNING APP connects as the non-owner, NOBYPASSRLS role
# `appuser` so tenant-isolation policies actually apply — set DATABASE_URL to the
# appuser pooler URI. Migrations/DDL still need the OWNER on a DIRECT (:5432)
# connection, via MIGRATE_DATABASE_URL (drizzle.config falls back to DATABASE_URL
# when unset, which is fine locally where the app already runs as the owner).
#   MIGRATE_DATABASE_URL=postgresql://postgres.<ref>:[PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Supabase (it's just Postgres — the app uses Drizzle/pg, NOT the JS SDK,
# so the anon/service_role keys are not needed here). Copy the URI from:
#   Supabase Dashboard → Project Settings → Database → Connection string → URI
# It looks like one of:
#   postgresql://postgres:[PASSWORD]@db.<ref>.supabase.co:5432/postgres
#   postgresql://postgres.<ref>:[PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres
# Then: npm run db:migrate && npm run db:seed

# ─── Auth (Auth.js v5) ─────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=replace-me-with-a-long-random-string
AUTH_TRUST_HOST=true

# ─── Object storage (MinIO / S3-compatible) ────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sellerctrl
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Public base URL used to build file links (proxy through the app)
S3_PUBLIC_URL=http://localhost:9000/sellerctrl

# ─── App ───────────────────────────────────────────────────────
APP_URL=http://localhost:3000
NODE_ENV=development

# ─── Amazon SP-API (optional — enables "ربط أمازون" on a platform page) ──
# Create a "Public" app in Seller Central → Develop Apps, then set its
# OAuth Redirect URI to  <APP_URL>/api/erp/marketplace/amazon/callback
# SPAPI_LWA_CLIENT_ID=amzn1.application-oa2-client.xxxxx
# SPAPI_LWA_CLIENT_SECRET=amzn1.oa2-cs.v1.xxxxx
# SPAPI_APP_ID=amzn1.sp.solution.xxxxx        # the App ID (application_id in the consent URL)
# SPAPI_DRAFT=1                                # set only while the app is still a DRAFT in Seller Central

# ─── xpay (optional — enables online SaaS subscription checkout) ──
# One platform-level xpay account. PREFERRED: configure it from the admin panel
# (/admin/integrations) — no env needed. These env vars are only a fallback.
# In the xpay dashboard → Developers: copy the Secret key, and under Webhooks add
# <APP_URL>/api/subscription/xpay/webhook (event checkout.session.completed) and copy
# its signing secret. Leave unset = the online-payment option is hidden (tenants still
# pay via InstaPay / Vodafone Cash / bank transfer).
# XPAY_BASE_URL=https://api.xpay.app
# XPAY_SECRET_KEY=sk_live_xxxxx        # or sk_test_xxxxx
# XPAY_WEBHOOK_SECRET=whsec_xxxxx

# ═══════════════════════════════════════════════════════════════
#  VERCEL DEPLOYMENT — set these in Vercel → Project → Settings → Environment Variables
# ═══════════════════════════════════════════════════════════════
# DATABASE_URL  → Supabase TRANSACTION pooler (port 6543) for serverless:
#   postgresql://postgres.<ref>:[PASSWORD]@aws-1-<region>.pooler.supabase.com:6543/postgres
# AUTH_SECRET   → same long random string
# AUTH_URL      → https://<your-app>.vercel.app
# AUTH_TRUST_HOST=true
# CRON_SECRET   → any long random string (guards /api/cron, called by Vercel Cron)
# Daily email reminders (optional — /api/cron sends a digest of pending drafts /
# overdue invoices / stock alerts). Leave RESEND_API_KEY unset to disable.
# RESEND_API_KEY     → from resend.com
# REMINDER_EMAIL_FROM→ a verified sender, e.g. "SellerCtrl <reminders@yourdomain.com>"
# REMINDER_EMAIL_TO  → recipient(s), comma-separated
# APP_URL            → base URL for links in the email (defaults to the request origin)
#
# Item images → Supabase Storage via REST (simplest — no S3 keys needed). Create a
# PUBLIC bucket "sellerctrl", then set:
#   SUPABASE_URL=https://<ref>.supabase.co
#   SUPABASE_SERVICE_KEY=<service_role key>   (server-only; never exposed to client)
#   SUPABASE_BUCKET=sellerctrl

# --- SP-API real-time notifications (optional — feature is silently OFF without these) ---
# One shared SQS queue receives ORDER_CHANGE for ALL tenants; the worker routes by SellerId.
# The queue's access policy MUST allow Amazon SP-API to send:
#   { "Effect": "Allow", "Principal": { "AWS": "arn:aws:iam::437568002678:root" },
#     "Action": "sqs:SendMessage", "Resource": "<SPAPI_SQS_QUEUE_ARN>" }
# SPAPI_SQS_QUEUE_URL=https://sqs.eu-west-1.amazonaws.com/<account>/sellerctrl-spapi-notifications
# SPAPI_SQS_QUEUE_ARN=arn:aws:sqs:eu-west-1:<account>:sellerctrl-spapi-notifications
# AWS_REGION=eu-west-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
