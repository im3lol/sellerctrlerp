# ─── Database (Postgres) ───────────────────────────────────────
# Local Docker:
DATABASE_URL=postgres://sellerctrl:sellerctrl@localhost:5432/sellerctrl
#
# Supabase (it's just Postgres — the app uses Drizzle/pg, NOT the JS SDK,
# so the anon/service_role keys are not needed here). Copy the URI from:
#   Supabase Dashboard → Project Settings → Database → Connection string → URI
# It looks like one of:
#   postgresql://postgres:[PASSWORD]@db.<ref>.supabase.co:5432/postgres
#   postgresql://postgres.<ref>:[PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres
# Then: npm run db:migrate && npm run db:seed

# ─── Auth (Auth.js v5) ─────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=replace-me-with-a-long-random-string
AUTH_TRUST_HOST=true

# ─── Object storage (MinIO / S3-compatible) ────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sellerctrl
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Public base URL used to build file links (proxy through the app)
S3_PUBLIC_URL=http://localhost:9000/sellerctrl

# ─── App ───────────────────────────────────────────────────────
APP_URL=http://localhost:3000
NODE_ENV=development

# ═══════════════════════════════════════════════════════════════
#  VERCEL DEPLOYMENT — set these in Vercel → Project → Settings → Environment Variables
# ═══════════════════════════════════════════════════════════════
# DATABASE_URL  → Supabase TRANSACTION pooler (port 6543) for serverless:
#   postgresql://postgres.<ref>:[PASSWORD]@aws-1-<region>.pooler.supabase.com:6543/postgres
# AUTH_SECRET   → same long random string
# AUTH_URL      → https://<your-app>.vercel.app
# AUTH_TRUST_HOST=true
# CRON_SECRET   → any long random string (guards /api/cron, called by Vercel Cron)
#
# Item images → Supabase Storage via REST (simplest — no S3 keys needed). Create a
# PUBLIC bucket "sellerctrl", then set:
#   SUPABASE_URL=https://<ref>.supabase.co
#   SUPABASE_SERVICE_KEY=<service_role key>   (server-only; never exposed to client)
#   SUPABASE_BUCKET=sellerctrl
